# Copy these to repo-root `.env` (docker compose reads that file, NOT this one).

# Postgres (defaults match docker-compose db service)
MM_DATABASE_URL=postgresql://meysam:Welcome123@localhost:5432/postgres

# HTTP transport (streamable-http at http://MCP_HOST:MCP_PORT/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_TRANSPORT=streamable-http

# --- Auth mode A: OAuth (Claude / Cursor) ---
# Generate: PYTHONPATH=. python -m mcp_servers.postgres.generate_oauth_credentials
MCP_OAUTH_CLIENT_ID=mm-cursor-client
MCP_OAUTH_CLIENT_SECRET=replace-with-long-random-secret
MCP_OAUTH_USERNAME=admin
MCP_OAUTH_PASSWORD=replace-with-login-password
# MCP_PUBLIC_URL=https://your-tunnel.trycloudflare.com  # required for tunnel; optional locally
MCP_PUBLIC_URL=https://assigned-alaska-shortcuts-criticism.trycloudflare.com

# --- Auth mode B: static Bearer token ---
# MCP_API_KEY=change-me-to-a-long-random-secret
