{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run mm_runtime (-m mm_runtime)",
      "type": "python",
      "request": "launch",
      "module": "mm_runtime",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run pipeline only (order_flow_pipeline.py)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/order_flow_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
