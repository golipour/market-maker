{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Print events + full runtime (-m mm.tools.print_events)",
      "type": "python",
      "request": "launch",
      "module": "mm.tools.print_events",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "mm/configs/market_maker.runtime.example.json",
        "--events",
        "30000",
        "--timeout-s",
        "12000"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Runtime CLI (-m mm.runtime)",
      "type": "python",
      "request": "launch",
      "module": "mm.runtime",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config",
        "mm/configs/market_maker.runtime.example.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
