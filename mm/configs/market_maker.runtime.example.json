{
  "primary": {
    "exchange": "nobitex",
    "symbol": "USDT_IRT",
    "mode": "rest",
    "depth_limit": 100,
    "trades_limit": 200,
    "poll_interval_ms": 1000
  },
  "hedge": {
    "exchange": "wallex",
    "symbol": "USDT_IRT",
    "mode": "rest",
    "depth_limit": 100,
    "trades_limit": 200,
    "poll_interval_ms": 1000
  },
  "interval_ms": 10000,
  "max_hedge_lag_ms": 2000,
  "hedge_grace_ms": 250,
  "bus": {
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-runtime",
    "consumer_name": "runtime",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "persistence": {
    "enabled": true,
    "database_url_env": "MM_DATABASE_URL",
    "parquet_root_env": "MM_PARQUET_ROOT",
    "topics": [
      "market:events:nobitex:USDT_IRT:10000",
      "market:events:wallex:USDT_IRT:10000",
      "strategy:frames:nobitex:USDT_IRT:10000",
      "strategy:actions",
      "strategy:decisions",
      "strategy:diagnostics:mpc-controller",
      "execution:orders:nobitex",
      "execution:orders:wallex",
      "execution:state:nobitex",
      "execution:state:wallex",
      "private:state:nobitex:snapshot",
      "private:state:wallex:snapshot",
      "private:state:nobitex:balances",
      "private:state:wallex:balances",
      "private:state:nobitex:open_orders",
      "private:state:wallex:open_orders",
      "private:state:nobitex:fills",
      "private:state:wallex:fills",
      "hedge:intents:hedge-executor",
      "hedge:diagnostics:hedge-executor"
    ],
    "batch_size": 100,
    "flush_interval_ms": 1000
  },
  "observability": {
    "service_name": "market-maker",
    "run_id": "",
    "metrics_enabled": true,
    "metrics_port": 8000,
    "json_logs": true,
    "log_path": "logs/mm-runtime.jsonl",
    "otel_enabled": false,
    "otlp_endpoint": "http://localhost:4318"
  },
  "primary_private": {
    "mode": "rest",
    "api_token_env": "NOBITEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "hedge_private": {
    "mode": "rest",
    "api_token_env": "WALLEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "controller": {
    "enabled": true,
    "observe_only": false,
    "action_start_after_steps": 100,
    "actor_id": "mpc-controller",
    "decisions_topic": "strategy:decisions",
    "action_topic": "strategy:actions",
    "orderbook_grid": {
      "spread_step": 10.0,
      "spread_max": 200.0
    },
    "max_orders_per_side": 100,
    "risk": {
      "enabled": true,
      "primary": {
        "min_inventory": 0.0,
        "max_inventory": 1000.0,
        "min_cash": 0.0,
        "max_open_notional": 100000000.0,
        "max_order_notional": 100000000.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      },
      "hedge": {
        "min_inventory": 0.0,
        "max_inventory": 1000.0,
        "min_cash": 0.0,
        "max_market_order_notional": 10000000.0,
        "max_slippage_bps": 100.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      }
    },
    "vwap_depth": 100.0,
    "price_model": {
      "kind": "residual",
      "residual_decay": 0.95,
      "residual_sigma": 1.0
    },
    "market_flow_model": {
      "kind": "hurdle_lognormal",
      "decay": 0.95,
      "init_p0": 0.3,
      "init_mu": 0.0,
      "init_sigma": 1.0
    },
    "hedge_price_model": {
      "kind": "legacy",
      "decay": 0.95,
      "sigma_min_quote": 1.0
    },
    "execution_model": {
      "kind": "real",
      "maker_fee": 0.0,
      "hedge_fee": 0.0
    },
    "optimizer": {
      "kind": "monte_carlo_mpc_tensor_batched",
      "n_components": 4,
      "n_samples": 64,
      "warm_start": true,
      "fixed_mc_samples": true,
      "horizon": 1,
      "adam_epochs": 100,
      "adam_lr": 1e-1,
      "device": "cpu",
      "expected_pnl_weight": 1.0,
      "pnl_volatility_penalty_weight": 0.0,
      "pnl_cvar_penalty_weight": 0.0,
      "cvar_softmax_temperature": 10.0,
      "inventory_target_penalty_weight": 0.0,
      "target_inventory": 10.0,
      "quote_shape_concentration_penalty_weight": 0.0,
      "quote_size_target_penalty_weight": 0.0,
      "quote_spread_penalty_weight": 1.0,
      "quote_depth_target_for_spread": 10.0,
      "quote_size_target_per_side": 3.0,
      "quote_size_softmax_L": false,
      "hard_project_quote_size_target": false,
      "quote_size_min_per_side": 0.1,
      "quote_size_max_per_side": 10.0,
      "hard_project_quote_size_range": false,
      "hedge_rollout_enabled": false
    }
  },
  "hedging": {
    "enabled": false,
    "observe_only": true,
    "actor_id": "hedge-executor",
    "dedupe_window_ms": 300000
  }
}
