{
  "primary": {
    "exchange": "nobitex",
    "symbol": "USDT_IRT",
    "mode": "rest",
    "depth_limit": 100,
    "trades_limit": 200,
    "poll_interval_ms": 1000
  },
  "hedge": {
    "exchange": "wallex",
    "symbol": "USDT_IRT",
    "mode": "rest",
    "depth_limit": 100,
    "trades_limit": 200,
    "poll_interval_ms": 1000
  },
  "interval_ms": 10000,
  "max_hedge_lag_ms": 2000,
  "hedge_grace_ms": 250,
  "bus": {
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-runtime",
    "consumer_name": "runtime",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "persistence": {
    "enabled": true,
    "database_url_env": "MM_DATABASE_URL",
    "parquet_root_env": "MM_PARQUET_ROOT",
    "topics": [
      "market:events:nobitex:USDT_IRT:10000",
      "market:events:wallex:USDT_IRT:10000",
      "strategy:frames:nobitex:USDT_IRT:10000",
      "strategy:actions",
      "strategy:controller",
      "execution:orders:nobitex",
      "execution:orders:wallex",
      "execution:state:nobitex",
      "execution:state:wallex",
      "private:state:nobitex:snapshot",
      "private:state:wallex:snapshot",
      "private:state:nobitex:balances",
      "private:state:wallex:balances",
      "private:state:nobitex:open_orders",
      "private:state:wallex:open_orders",
      "private:state:nobitex:fills",
      "private:state:wallex:fills"
    ],
    "batch_size": 100,
    "flush_interval_ms": 1000
  },
  "observability": {
    "service_name": "market-maker",
    "run_id": "",
    "metrics_enabled": true,
    "metrics_port": 8000,
    "json_logs": true,
    "log_path": "logs/mm-runtime.jsonl",
    "otel_enabled": false,
    "otlp_endpoint": "http://localhost:4318"
  },
  "primary_private": {
    "mode": "rest",
    "api_token_env": "NOBITEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "hedge_private": {
    "mode": "rest",
    "api_token_env": "WALLEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "controller": {
    "enabled": true,
    "observe_only": false,
    "action_start_after_steps": 3,
    "actor_id": "mpc-controller",
    "diagnostics_topic": "strategy:controller",
    "action_topic": "strategy:actions",
    "min_spread": 1000.0,
    "orderbook_grid": {
      "price_step": 1000.0,
      "max_spread": 100000.0
    },
    "qty_step": 0.0001,
    "min_order_qty": 0.0001,
    "max_orders_per_side": 10,
    "vwap_depth": 100.0,
    "price_model": {
      "kind": "residual",
      "residual_decay": 0.95,
      "residual_sigma": 1.0
    },
    "market_flow_model": {
      "kind": "hurdle_lognormal",
      "decay": 0.95,
      "init_p0": 0.3,
      "init_mu": 0.0,
      "init_sigma": 1.0
    },
    "hedge_price_model": {
      "kind": "legacy",
      "decay": 0.95,
      "sigma_min_quote": 1.0
    },
    "execution_model": {
      "kind": "real",
      "maker_fee": 0.00015,
      "hedge_fee": 0.0000025
    },
    "optimizer": {
      "kind": "monte_carlo_mpc_tensor_batched",
      "n_components": 1,
      "n_samples": 64,
      "warm_start": false,
      "fixed_mc_samples": true,
      "horizon": 1,
      "adam_epochs": 50,
      "adam_lr": 1e-3,
      "device": "cpu",
      "reward_coef": 1.0,
      "risk_coef": 1.0,
      "inv_coef": 0.0,
      "uniformity_coef": 0.0,
      "size_coef": 0.0,
      "spread_coef": 100.0,
      "spread_depth": 100000.0,
      "hedge_enabled": false,
      "hedge_coef": 0.0,
      "target_inventory_level": 10.0,
      "max_total_qty": 10.0,
      "project_max_total_qty": false
    }
  }
}
