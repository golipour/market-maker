{
  "venues": {
    "local": {
      "exchange": "nobitex",
      "symbol": "USDT_IRT",
      "mode": "rest",
      "depth_limit": 100,
      "trades_limit": 200,
      "poll_interval_ms": 1000
    },
    "global": {
      "exchange": "wallex",
      "symbol": "USDT_IRT",
      "mode": "rest",
      "depth_limit": 100,
      "trades_limit": 200,
      "poll_interval_ms": 1000
    }
  },
  "interval_ms": 10000,
  "max_global_lag_ms": 2000,
  "global_grace_ms": 250,
  "local_private": {
    "mode": "rest",
    "api_token_env": "NOBITEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true,
    "fill_event_source": "exchange_fill_history"
  },
  "global_private": {
    "mode": "rest",
    "api_token_env": "WALLEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true,
    "fill_event_source": "exchange_fill_history"
  },
  "liquidity_sourcing": {
    "enabled": false,
    "mode": "liquidity_sourcing",
    "global_live_orders": false
  },
  "execution": {
    "local": {
      "planner": "replace"
    },
    "global": {
      "planner": "replace"
    }
  },
  "bus": {
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-runtime",
    "consumer_name": "runtime",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "persistence": {
    "enabled": true,
    "database_url_env": "MM_DATABASE_URL",
    "parquet_root_env": "MM_PARQUET_ROOT",
    "batch_size": 100,
    "flush_interval_ms": 1000
  },
  "observability": {
    "service_name": "market-maker",
    "run_id": "",
    "metrics_enabled": true,
    "metrics_port": 8000,
    "json_logs": true,
    "log_path": "logs/mm-runtime.jsonl",
    "otel_enabled": false,
    "otlp_endpoint": "http://localhost:4318"
  },
  "controller": {
    "enabled": true,
    "observe_only": false,
    "action_start_after_steps": 10,
    "placement_timeout_ms": 7000,
    "placement_max_concurrency": 32,
    "actor_id": "mpc-controller",
    "decisions_topic": "strategy:decisions",
    "action_topic": "strategy:actions",
    "orderbook_grid": {
      "spread_step": 40.0,
      "spread_max": 400.0
    },
    "max_orders_per_side": 10,
    "risk": {
      "enabled": true,
      "engine": "net_delta",
      "local": {
        "min_inventory": 0.0,
        "max_inventory": 10000.0,
        "min_cash": 0.0,
        "max_open_notional": 1000000000.0,
        "max_order_notional": 1000000000.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      },
      "global": {
        "min_inventory": 0.0,
        "max_inventory": 1000.0,
        "min_cash": 0.0,
        "max_open_notional": 100000000.0,
        "max_order_notional": 100000000.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      }
    },
    "reference_price_source": "global",
    "local_price_model": {
      "kind": "residual",
      "residual_decay": 0.95,
      "residual_sigma": 1.0
    },
    "local_market_flow_model": {
      "kind": "hurdle_lognormal",
      "decay": 0.95,
      "init_p0": 0.3,
      "init_mu": 0.0,
      "init_sigma": 1.0
    },
    "global_market_flow_model": {
      "kind": "hurdle_lognormal",
      "decay": 0.95,
      "init_p0": 0.3,
      "init_mu": 0.0,
      "init_sigma": 1.0
    },
    "global_price_model": {
      "kind": "ewma_gaussian",
      "decay": 0.95,
      "sigma_min_quote": 1.0
    },
    "execution_model": {
      "kind": "real",
      "local_maker_fee": 0.0015,
      "global_maker_fee": 0.0025
    },
    "optimizer": {
      "kind": "monte_carlo_mpc_tensor_batched",
      "n_components": 4,
      "n_samples": 64,
      "warm_start": false,
      "fixed_mc_samples": true,
      "horizon": 1,
      "adam_epochs": 30,
      "adam_lr": 1e0,
      "device": "cpu",
      "local": {
        "objective_weight": 1.0,
        "return_risk_aversion_beta": 0.1,
        "inventory_threshold_penalty_weight": 0.00001,
        "cash_threshold": 20000000,
        "inventory_threshold": 20,
        "quote_size_min_per_side": 1.0,
        "quote_size_max_per_side": 10.0,
        "quote_capacity_ratio": 0.5,
        "quote_spread_max": 200.0,
        "quote_spread_min_depth": 0.0,
        "quote_spread_k_epsilon": 0.01,
        "soft_fill_temp": 0.1,
        "soft_fill_activation": "hardsigmoid",
        "soft_fill_queue_model": "back_of_queue"
      },
      "global": {
        "objective_weight": 1.0,
        "return_risk_aversion_beta": 0.1,
        "inventory_threshold_penalty_weight": 0.0,
        "cash_threshold": 50000000.0,
        "inventory_threshold": 100.0,
        "quote_size_min_per_side": 1.0,
        "quote_size_max_per_side": 10.0,
        "quote_capacity_ratio": 0.5,
        "quote_spread_max": 100.0,
        "quote_spread_min_depth": 0.3,
        "quote_spread_k_epsilon": 0.01,
        "soft_fill_temp": 0.1,
        "soft_fill_activation": "hardsigmoid",
        "soft_fill_queue_model": "back_of_queue"
      }
    }
  }
}
