{
  "_comment": "JSON has no comments, so this example uses _comment/_options keys. The runtime ignores these helper keys.",
  "_option_reference": {
    "exchanges.*.market_data.mode": ["rest", "websocket"],
    "exchanges.*.private.mode": ["rest"],
    "exchanges.*.private.fill_event_source": ["exchange_fill_history", "open_order_delta"],
    "strategy_presets.*.liquidity_sourcing.mode": ["off", "simulate", "live"],
    "strategy_presets.*.execution.*.planner": ["reconcile", "replace"],
    "strategy_presets.*.controller.local_price_model.kind": ["residual", "conditional_mechanical_mixture"],
    "strategy_presets.*.controller.global_price_model.kind": ["ewma_gaussian", "conditional_mechanical_mixture"],
    "strategy_presets.*.controller.*_market_flow_model.kind": ["hurdle_lognormal", "hurdle_gamma", "gamma", "weibull", "hurdle_weibull"],
    "strategy_presets.*.controller.optimizer.kind": ["monte_carlo_mpc_tensor_batched"],
    "strategy_presets.*.controller.optimizer.*.soft_fill_activation": ["sigmoid", "hardsigmoid"],
    "strategy_presets.*.controller.optimizer.*.soft_fill_queue_model": ["back_of_queue", "pro_rata"],
    "bus.kind": ["memory", "redis_streams"]
  },
  "exchanges": {
    "nobitex": {
      "market_data": {
        "_comment": "Public market-data transport and polling defaults for this exchange.",
        "_options": {"mode": ["rest", "websocket"]},
        "mode": "rest",
        "depth_limit": 100,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      },
      "private": {
        "_comment": "Private state credentials. Execution is controlled by the strategy preset, not by this block.",
        "_options": {
          "mode": ["rest"],
          "fill_event_source": ["exchange_fill_history", "open_order_delta"]
        },
        "mode": "rest",
        "api_token_env": "NOBITEX_API_TOKEN",
        "api_private_key_env": "NOBITEX_API_PRIVATE_KEY",
        "poll_interval_ms": 10000,
        "fill_event_source": "exchange_fill_history"
      },
      "fees": {
        "maker_fee": 0.0015
      }
    },
    "tabdeal": {
      "market_data": {
        "_comment": "A market-data source can be used as a liquidity source or as a reference exchange by any bot.",
        "_options": {"mode": ["rest", "websocket"]},
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      },
      "private": {
        "_options": {
          "mode": ["rest"],
          "fill_event_source": ["exchange_fill_history", "open_order_delta"]
        },
        "mode": "rest",
        "api_token_env": "TABDEAL_API_TOKEN",
        "api_private_key_env": "TABDEAL_API_PRIVATE_KEY",
        "poll_interval_ms": 10000,
        "fill_event_source": "exchange_fill_history"
      },
      "fees": {
        "maker_fee": 0.0033
      }
    },
    "wallex": {
      "market_data": {
        "_options": {"mode": ["rest", "websocket"]},
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      },
      "private": {
        "_options": {
          "mode": ["rest"],
          "fill_event_source": ["exchange_fill_history", "open_order_delta"]
        },
        "mode": "rest",
        "api_token_env": "WALLEX_API_TOKEN",
        "poll_interval_ms": 10000,
        "fill_event_source": "exchange_fill_history"
      },
      "fees": {
        "maker_fee": 0.002
      }
    },
    "bitpin": {
      "market_data": {
        "_options": {"mode": ["rest", "websocket"]},
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      },
      "private": {
        "_options": {
          "mode": ["rest"],
          "fill_event_source": ["exchange_fill_history", "open_order_delta"]
        },
        "mode": "rest",
        "api_token_env": "BITPIN_API_TOKEN",
        "api_private_key_env": "BITPIN_API_PRIVATE_KEY",
        "poll_interval_ms": 10000,
        "fill_event_source": "exchange_fill_history"
      },
      "fees": {
        "maker_fee": 0.003
      }
    }
  },
  "strategy_presets": {
    "thin_local_liquidity_weighted_mpc": {
      "interval_ms": 10000,
      "max_global_lag_ms": 2000,
      "global_grace_ms": 250,
      "liquidity_sourcing": {
        "_comment": "off = observe the liquidity exchange only for pricing; simulate = include it in model/objective but never route liquidity orders; live = include it and allow live liquidity orders. If liquidity_exchange equals quoting_exchange, this resolves to off internally.",
        "_options": {"mode": ["off", "simulate", "live"]},
        "mode": "off"
      },
      "pricing": {
        "_comment": "quote_anchor centers maker quotes; inventory_mark selects the venue whose inventory-depth liquidation VWAP marks wealth.",
        "quote_anchor": {
          "_options": {"mode": ["quoting_mid", "liquidity_mid", "liquidity_weighted_mid"]},
          "_comment": "liquidity_weighted_mid computes bid/ask VWAPs inside anchor_vwap_bps on both venues and weights each side by the volume inside that bps window.",
          "mode": "liquidity_mid",
          "anchor_vwap_bps": 100.0
        },
        "inventory_mark": {
          "_options": {"venue": ["quoting", "liquidity"]},
          "_comment": "Long inventory is marked at selected venue bid-side VWAP; short inventory at ask-side VWAP. The VWAP volume is derived from inventory.",
          "venue": "liquidity"
        }
      },
      "execution": {
        "quoting": {
          "_comment": "Execution policy for the quoting exchange selected by the bot.",
          "_options": {"planner": ["reconcile", "replace"]},
          "enabled": true,
          "planner": "replace",
          "max_orders_per_side": 10
        },
        "liquidity": {
          "_comment": "Planner and caps for liquidity_exchange. Do not set enabled here; source live execution is controlled only by liquidity_sourcing.mode = live.",
          "_options": {"planner": ["reconcile", "replace"]},
          "planner": "replace",
          "max_orders_per_side": 2
        }
      },
      "controller": {
        "_comment": "MPC controller settings for any bot using this preset. Bot id becomes actor_id unless actor_id is set here.",
        "enabled": true,
        "dry_run": false,
        "execution_after_steps": 10,
        "decision_timeout_ms": 3000,
        "placement_timeout_ms": 7000,
        "placement_max_concurrency": 32,
        "decisions_topic": "strategy:decisions",
        "action_topic": "strategy:actions",
        "orderbook_grid": {
          "_comment": "Absolute quote-per-base spread grid used for both optimizer depth curves and target order ladder prices.",
          "spread_step": 20.0,
          "spread_max": 200.0
        },
        "risk": {
          "_comment": "Hard pre-execution gates. local = quoting exchange, global = selected liquidity source/reference slot.",
          "enabled": true,
          "engine": "net_delta",
          "local": {
            "min_inventory": 0.0,
            "max_inventory": 10000.0,
            "min_cash": 0.0,
            "max_open_notional": 1000000000.0,
            "max_order_notional": 1000000000.0,
            "max_market_data_age_ms": 60000,
            "max_private_state_age_ms": 120000
          },
          "global": {
            "min_inventory": 0.0,
            "max_inventory": 1000.0,
            "min_cash": 0.0,
            "max_open_notional": 100000000.0,
            "max_order_notional": 100000000.0,
            "max_market_data_age_ms": 60000,
            "max_private_state_age_ms": 120000
          }
        },
        "local_price_model": {
          "kind": "conditional_mechanical_mixture",
          "reference_vwap_vol": 1000.0,
          "shape_alpha": 0.5,
          "decay": 0.99,
          "initial_sigma": 50.0,
          "initial_log_sigma": 0.25,
          "student_df": 3.0,
          "point_mode": "sample"
        },
        "local_market_flow_model": {
          "kind": "hurdle_lognormal",
          "decay": 0.95,
          "init_p0": 0.3,
          "init_mu": 0.0,
          "init_sigma": 1.0
        },
        "global_market_flow_model": {
          "kind": "hurdle_lognormal",
          "decay": 0.95,
          "init_p0": 0.3,
          "init_mu": 0.0,
          "init_sigma": 1.0
        },
        "global_price_model": {
          "kind": "conditional_mechanical_mixture",
          "reference_vwap_vol": 100.0,
          "shape_alpha": 0.5,
          "decay": 0.99,
          "student_df": 3.0
        },
        "_optimizer_comment": "Do not add helper _comment keys inside optimizer.local or optimizer.global; those nested objects intentionally reject unknown keys.",
        "_optimizer_options": {
          "kind": ["monte_carlo_mpc_tensor_batched"],
          "local/global.soft_fill_activation": ["sigmoid", "hardsigmoid"],
          "local/global.soft_fill_queue_model": ["back_of_queue", "pro_rata"],
          "device": ["cpu", "cuda"]
        },
        "optimizer": {
          "kind": "monte_carlo_mpc_tensor_batched",
          "n_samples": 64,
          "warm_start": false,
          "fixed_mc_samples": true,
          "horizon": 1,
          "adam_epochs": 30,
          "adam_lr": 1e0,
          "device": "cpu",
          "local": {
            "n_components": 4,
            "objective_weight": 1.0,
            "return_risk_aversion_beta": 0.1,
            "quote_size_min_per_side": 1.0,
            "quote_capacity_ratio": 0.5,
            "quote_imbalance_skew_strength": 0.5,
            "quote_spread_max": 200.0,
            "quote_spread_min_depth": 0.0,
            "quote_spread_k_epsilon": 0.01,
            "soft_fill_temp": 0.1,
            "soft_fill_activation": "hardsigmoid",
            "soft_fill_queue_model": "back_of_queue"
          },
          "global": {
            "n_components": 2,
            "objective_weight": 1.0,
            "return_risk_aversion_beta": 0.1,
            "quote_size_min_per_side": 1.0,
            "quote_capacity_ratio": 0.5,
            "quote_imbalance_skew_strength": 0.5,
            "quote_spread_max": 100.0,
            "quote_spread_min_depth": 0.3,
            "quote_spread_k_epsilon": 0.01,
            "soft_fill_temp": 0.1,
            "soft_fill_activation": "hardsigmoid",
            "soft_fill_queue_model": "back_of_queue"
          }
        }
      }
    }
  },
  "bots": {
    "mpc-controller": {
      "_comment": "One runtime config currently starts one bot. quoting_exchange is where maker quotes are placed; liquidity_exchange is the second book and optional liquidity-source venue.",
      "preset": "thin_local_liquidity_weighted_mpc",
      "symbol": "USDT_IRT",
      "quoting_exchange": "wallex",
      "liquidity_exchange": "wallex"
    }
  },
  "bus": {
    "_options": {"kind": ["memory", "redis_streams"]},
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-runtime",
    "consumer_name": "runtime",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "persistence": {
    "enabled": true,
    "database_url_env": "MM_DATABASE_URL",
    "parquet_root_env": "MM_PARQUET_ROOT",
    "batch_size": 100,
    "flush_interval_ms": 1000,
    "retention": {
      "_comment": "Applied by python -m mm.tools.apply_retention on a schedule. null disables a tier.",
      "events_days": 14,
      "facts_days": 90,
      "latest_state_days": null,
      "admin_audit_days": 365,
      "parquet_days": 90,
      "spool_archive_days": 7,
      "spool_failed_days": 30
    }
  },
  "observability": {
    "service_name": "market-maker",
    "run_id": "",
    "metrics_enabled": true,
    "metrics_port": 8000,
    "json_logs": true,
    "log_path": "logs/mm-runtime.jsonl",
    "otel_enabled": false,
    "otlp_endpoint": "http://localhost:4318"
  }
}
