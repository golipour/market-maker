{
  "venues": {
    "local": {
      "exchange": "nobitex",
      "symbol": "USDT_IRT",
      "mode": "rest",
      "depth_limit": 100,
      "trades_limit": 200,
      "poll_interval_ms": 1000
    },
    "global": {
      "exchange": "wallex",
      "symbol": "USDT_IRT",
      "mode": "rest",
      "depth_limit": 100,
      "trades_limit": 200,
      "poll_interval_ms": 1000
    }
  },
  "interval_ms": 10000,
  "max_global_lag_ms": 2000,
  "global_grace_ms": 250,
  "local_private": {
    "mode": "rest",
    "api_token_env": "NOBITEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "global_private": {
    "mode": "rest",
    "api_token_env": "WALLEX_API_TOKEN",
    "poll_interval_ms": 10000,
    "enable_execution": true
  },
  "liquidity_sourcing": {
    "enabled": false,
    "mode": "liquidity_sourcing",
    "global_live_orders": true
  },
  "execution": {
    "local": {
      "planner": "replace"
    },
    "global": {
      "planner": "replace",
      "max_order_qty": 0.5,
      "max_quote_distance": 10.0
    }
  },
  "bus": {
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-runtime",
    "consumer_name": "runtime",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "persistence": {
    "enabled": true,
    "database_url_env": "MM_DATABASE_URL",
    "parquet_root_env": "MM_PARQUET_ROOT",
    "topics": [
      "market:events:nobitex:USDT_IRT:10000",
      "market:events:wallex:USDT_IRT:10000",
      "strategy:joint:frames:nobitex:USDT_IRT:10000",
      "strategy:actions",
      "strategy:decisions",
      "strategy:diagnostics:mpc-controller",
      "strategy:target_books:mpc-controller",
      "execution:orders:nobitex",
      "execution:orders:wallex",
      "execution:state:nobitex",
      "execution:state:wallex",
      "private:state:nobitex:snapshot",
      "private:state:wallex:snapshot",
      "ledger:snapshot"
    ],
    "batch_size": 100,
    "flush_interval_ms": 1000
  },
  "observability": {
    "service_name": "market-maker",
    "run_id": "",
    "metrics_enabled": true,
    "metrics_port": 8000,
    "json_logs": true,
    "log_path": "logs/mm-runtime.jsonl",
    "otel_enabled": false,
    "otlp_endpoint": "http://localhost:4318"
  },
  "controller": {
    "enabled": true,
    "observe_only": false,
    "action_start_after_steps": 10,
    "placement_timeout_ms": 3000,
    "placement_max_concurrency": 8,
    "actor_id": "mpc-controller",
    "decisions_topic": "strategy:decisions",
    "action_topic": "strategy:actions",
    "orderbook_grid": {
      "spread_step": 20.0,
      "spread_max": 200.0
    },
    "risk": {
      "enabled": true,
      "engine": "net_delta",
      "local": {
        "min_inventory": 0.0,
        "max_inventory": 1000.0,
        "min_cash": 0.0,
        "max_open_notional": 100000000.0,
        "max_order_notional": 100000000.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      },
      "global": {
        "min_inventory": 0.0,
        "max_inventory": 1000.0,
        "min_cash": 0.0,
        "max_market_order_notional": 10000000.0,
        "max_slippage_bps": 100.0,
        "max_market_data_age_ms": 60000,
        "max_private_state_age_ms": 120000
      }
    },
    "vwap_depth": 100.0,
    "price_model": {
      "kind": "residual",
      "residual_decay": 0.95,
      "residual_sigma": 1.0
    },
    "market_flow_model": {
      "kind": "hurdle_lognormal",
      "decay": 0.95,
      "init_p0": 0.3,
      "init_mu": 0.0,
      "init_sigma": 1.0
    },
    "global_price_model": {
      "kind": "legacy",
      "decay": 0.95,
      "sigma_min_quote": 1.0
    },
    "execution_model": {
      "kind": "real",
      "maker_fee": 0.0,
      "global_fee": 0.0
    },
    "optimizer": {
      "kind": "monte_carlo_mpc_tensor_batched",
      "n_components": 4,
      "n_samples": 64,
      "warm_start": false,
      "fixed_mc_samples": true,
      "horizon": 1,
      "adam_epochs": 50,
      "adam_lr": 1e-1,
      "device": "cpu",
      "return_risk_aversion_beta": 0.1,
      "inventory_target_penalty_weight": 0.00001,
      "target_inventory_multiplier": 2.0,
      "quote_size_min_per_side": 0.3,
      "quote_size_max_per_side": 10.0,
      "quote_spread_max": 100.0,
      "quote_spread_min_depth": 0.3,
      "quote_spread_k_epsilon": 0.01,
      "soft_fill_temp": 0.1,
      "soft_fill_activation": "hardsigmoid"
    }
  }
}
