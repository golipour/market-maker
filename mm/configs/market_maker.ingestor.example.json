{
  "_comment": "Shared ingestor. Set load_feeds_from_registry when feeds are managed in the platform UI (requires MM_DATABASE_URL). Restart ingestor after registry feed changes.",
  "load_feeds_from_registry": true,
  "exclude_exchanges": ["kucoin"],
  "feeds": [
    {
      "exchange": "nobitex",
      "symbol": "USDT_IRT",
      "interval_ms": 10000
    }
  ],
  "exchanges": {
    "nobitex": {
      "market_data": {
        "mode": "rest",
        "depth_limit": 100,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      }
    },
    "tabdeal": {
      "market_data": {
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      }
    },
    "wallex": {
      "market_data": {
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      }
    },
    "bitpin": {
      "market_data": {
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      }
    },
    "bitwana": {
      "market_data": {
        "mode": "rest",
        "depth_limit": 200,
        "trades_limit": 200,
        "poll_interval_ms": 2000
      }
    }
  },
  "bus": {
    "kind": "redis_streams",
    "redis_url": "redis://localhost:6379/0",
    "stream_prefix": "mm",
    "consumer_group": "mm-ingestor",
    "consumer_name": "ingestor-1",
    "max_stream_length": 100000,
    "read_block_ms": 1000
  },
  "observability": {
    "service_name": "market-maker-ingestor",
    "metrics_enabled": true,
    "metrics_port": 8001,
    "json_logs": true,
    "log_path": "logs/mm-ingestor.jsonl"
  },
  "scheduler": {
    "max_concurrency": 8
  }
}
