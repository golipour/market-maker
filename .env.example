# Copy to `.env` in the repository root (gitignored). Loaded at runtime via `mm.env_loader`.

# Exchange API tokens (referenced from runtime JSON as api_token_env)
# NOBITEX_API_TOKEN=
# WALLEX_API_TOKEN=

# Torch: unset = auto-select device
# MM_TORCH_DEVICE=cpu

MM_SERVICE=market_maker
MM_ENV=local
MM_METRICS_PORT=8000
MM_JSON_LOG=0

# MM_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# MM_PARQUET_ROOT=./data/parquet
