# Single environment file: copy to `.env` in this repository root (gitignored).
# Loaded by `mm.env_loader.load_mm_env()` when the runtime starts.

# --- Exchange API (names must match JSON `api_token_env`, e.g. NOBITEX_API_TOKEN) ---
# NOBITEX_API_TOKEN=
# WALLEX_API_TOKEN=

# --- Optional: Torch ---
# MM_TORCH_DEVICE=cpu

# --- Service identity (observability defaults) ---
MM_SERVICE=market_maker
MM_ENV=local

# --- Metrics HTTP (/metrics) when port is set ---
MM_METRICS_PORT=8000
# MM_METRICS_LABEL_RUN_ID=0

# --- Logs ---
MM_JSON_LOG=0
# MM_LOG_PATH=logs/mm-runtime.jsonl

# --- Tracing (optional) ---
# MM_TRACE_ID=
# MM_RUN_ID=

# --- Persistence ---
# MM_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# MM_PARQUET_ROOT=./data/parquet

# --- Redis bus (if config uses redis_streams; often also in JSON) ---
# REDIS_URL=redis://localhost:6379/0
