# Single environment file: copy to `.env` in this repository root (gitignored).
# Loaded by `mm.env_loader.load_mm_env()` when the runtime starts.

# --- Exchange API (optional fallback when not using registry UI credentials) ---
# Prefer storing credentials in the Accounts UI (registry DB). These env vars remain
# supported for local monolith JSON configs and legacy deployments.
#
# Unified names: API_KEY, API_SECRET, API_PASSPHRASE (exchange-prefixed).
#
# Wallex (api_key auth):
# WALLEX_API_KEY=
#
# Nobitex (signed_key auth — public key + Ed25519 private secret):
# NOBITEX_API_KEY=
# NOBITEX_API_SECRET=
#
# Tabdeal / Bitpin (signed_key auth):
# TABDEAL_API_KEY=
# TABDEAL_API_SECRET=
#
# KuCoin (signed_key_passphrase auth):
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
#
# Legacy aliases still resolved: *_API_TOKEN, *_API_PRIVATE_KEY

# --- Optional: Torch ---
# MM_TORCH_DEVICE=cpu

# --- Service identity (observability defaults) ---
MM_SERVICE=market_maker
MM_ENV=local

# --- Metrics HTTP (/metrics) when port is set ---
MM_METRICS_PORT=8000
# MM_METRICS_LABEL_RUN_ID=0

# --- Logs ---
MM_JSON_LOG=0
# MM_LOG_PATH=logs/mm-runtime.jsonl

# --- Tracing (optional) ---
# MM_TRACE_ID=
# MM_RUN_ID=

# --- Persistence ---
# MM_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# MM_PARQUET_ROOT=./data/parquet

# --- Redis bus (if config uses redis_streams; often also in JSON) ---
# REDIS_URL=redis://localhost:6379/0

# --- Postgres MCP server (optional; see mcp_servers/postgres/README.md) ---
# MCP_PUBLIC_URL=https://mcp.your-tunnel-host.example.com
# MCP_OAUTH_CLIENT_ID=mm-cursor-client
# MCP_OAUTH_CLIENT_SECRET=replace-with-long-random-secret
# MCP_OAUTH_USERNAME=admin
# MCP_OAUTH_PASSWORD=replace-with-login-password
# MCP_API_KEY=change-me-to-a-long-random-secret
# MCP_PORT=8787
