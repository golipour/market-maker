# Copy to `.env` (gitignored). Loaded by mm_runtime / order_flow_pipeline.main.

# Torch: unset = auto (CPU if GPU is too old for your PyTorch wheel, e.g. GTX 960M + nightly CUDA builds).
# MM_TORCH_DEVICE=cpu
# MM_TORCH_DEVICE=cuda

MM_SERVICE=market_maker
MM_ENV=local
MM_METRICS_PORT=8000
MM_JSON_LOG=0

MM_DIAGNOSTICS=1
MM_DIAGNOSTICS_REDIS_URL=redis://localhost:6379/0
MM_DIAGNOSTICS_CHANNEL=mm.diagnostics.v1
# Compact Pub/Sub (v2 patch envelopes). Redis SET still stores the full frame. Set on the runner, not mm_viz.
MM_DIAGNOSTICS_DELTA=1
