# Copy to `.env` (gitignored). Loaded by the runtime CLI (`mm.tools.print_events` / `mm.runtime`).

# Torch: unset = auto (CPU if GPU is too old for your PyTorch wheel, e.g. GTX 960M + nightly CUDA builds).
# MM_TORCH_DEVICE=cpu
# MM_TORCH_DEVICE=cuda

MM_SERVICE=market_maker
MM_ENV=local
MM_METRICS_PORT=8000
MM_JSON_LOG=0

MM_DATABASE_URL=postgresql://meysam:Welcome123@localhost:5432/postgres
MM_PARQUET_ROOT=./data/parquet
