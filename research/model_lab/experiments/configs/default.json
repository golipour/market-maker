{
  "_comment": "Matches strategy_presets.conservative_local.controller in mm/configs/market_maker.runtime.example.json",
  "_problem": "Walk-forward NLL on interval steps: predict next bucket's flow (buy/sell volume) and price (book transition) using only past observations. See GUIDE.md sections 1-2.",
  "exchange": "nobitex",
  "symbol": "USDT_IRT",
  "interval_ms": 30000,
  "since": "48h",
  "source": "auto",
  "min_updates_before_score": 1,
  "models": [
    "baseline:zero_flow",
    "baseline:mid_random_walk",
    "flow:hurdle_lognormal",
    "flow:hurdle_gamma",
    "flow:hurdle_weibull",
    "price:residual",
    "price:conditional_mechanical_mixture"
  ],
  "production_local_market_flow_model": {
    "kind": "hurdle_lognormal",
    "decay": 0.95,
    "init_p0": 0.3,
    "init_mu": 0.0,
    "init_sigma": 1.0,
    "lab_spec": "flow:hurdle_lognormal"
  },
  "production_local_price_model": {
    "kind": "conditional_mechanical_mixture",
    "reference_vwap_vol": 1000.0,
    "shape_alpha": 0.5,
    "decay": 0.99,
    "initial_sigma": 50.0,
    "initial_log_sigma": 0.25,
    "student_df": 3.0,
    "point_mode": "sample",
    "lab_spec": "price:conditional_mechanical_mixture"
  },
  "production_alternative_local_price_model": {
    "kind": "residual",
    "residual_decay": 0.95,
    "residual_sigma": 50.0,
    "lab_spec": "price:residual"
  }
}
