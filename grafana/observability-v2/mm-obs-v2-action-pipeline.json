      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.ts, e.actor_id, e.exchange, e.symbol, stage,\n       (e.payload #>> ARRAY['action_pipeline', stage, 'order_count'])::double precision AS order_count,\n       (e.payload #>> ARRAY['action_pipeline', stage, 'buy_qty'])::double precision AS buy_qty,\n       (e.payload #>> ARRAY['action_pipeline', stage, 'sell_qty'])::double precision AS sell_qty,\n       e.payload #> ARRAY['action_pipeline', stage, 'rejection_counts'] AS rejection_counts\nFROM mm_events e\nCROSS JOIN LATERAL unnest(ARRAY['ladder','venue_quantized','capped','target_book','risk_approved_target','planned_place','rules_valid','router_accepted','kept']) AS stage\nWHERE e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange IN (${exchange:sqlstring})\n  AND e.symbol IN (${symbol:sqlstring})\n  AND e.actor_id IN (${actor_id:sqlstring})\n  AND ($__timeFilter(e.ts))\nORDER BY e.ts DESC, stage\nLIMIT 300",
          "refId": "A"
        }
      ],
      "title": "Pipeline stage rows",
      "type": "table",
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false
        },
        "showHeader": true
      }
    }
