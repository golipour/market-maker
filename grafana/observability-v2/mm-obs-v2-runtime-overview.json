      "id": 10,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.ts, e.actor_id, e.exchange, e.symbol, w.warning\nFROM mm_events e\nCROSS JOIN LATERAL jsonb_array_elements_text(COALESCE(e.payload->'warnings', '[]'::jsonb)) AS w(warning)\nWHERE e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange IN (${exchange:sqlstring})\n  AND e.symbol IN (${symbol:sqlstring})\n  AND e.actor_id IN (${actor_id:sqlstring})\n  AND ($__timeFilter(e.ts))\nORDER BY e.ts DESC\nLIMIT 25",
          "refId": "A"
        }
      ],
      "title": "Latest controller warnings",
      "type": "table",
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false
        },
        "showHeader": true
      }
    }
