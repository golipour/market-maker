          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\", stage AS metric,\n       (e.payload #>> ARRAY['optimizer','objective',stage,'value'])::double precision AS value\nFROM mm_events e\nCROSS JOIN LATERAL unnest(ARRAY['initial','final','best']) AS stage\nWHERE e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange IN (${exchange:sqlstring})\n  AND e.symbol IN (${symbol:sqlstring})\n  AND e.actor_id IN (${actor_id:sqlstring})\n  AND ($__timeFilter(e.ts))\n  AND e.payload #>> ARRAY['optimizer','objective',stage,'value'] IS NOT NULL\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Objective value",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
