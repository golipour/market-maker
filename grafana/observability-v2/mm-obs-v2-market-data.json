      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval),\n       (exchange || ' ' || symbol) AS metric,\n       COUNT(*)::double precision AS value\nFROM mm_events\nWHERE event_type = 'MarketEvent'\n  AND exchange IN (${exchange:sqlstring})\n  AND symbol IN (${symbol:sqlstring})\n  AND $__timeFilter(ts)\nGROUP BY 1, exchange, symbol\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Market event rate",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\",\n       (exchange || ' ' || symbol) AS metric,\n       GREATEST(0, EXTRACT(EPOCH FROM now()) * 1000 - (payload->>'t_end_ms')::double precision) AS value\nFROM mm_events\nWHERE event_type = 'MarketEvent'\n  AND exchange IN (${exchange:sqlstring})\n  AND symbol IN (${symbol:sqlstring})\n  AND $__timeFilter(ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Market event age (ms)",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
