        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", (exchange || ' best_bid') AS metric,\n       (payload->'orderbook'->'bids'->0->>'price')::double precision AS value\nFROM mm_events\nWHERE event_type = 'MarketEvent' AND exchange IN (${exchange:sqlstring}) AND symbol IN (${symbol:sqlstring}) AND $__timeFilter(ts)\nUNION ALL\nSELECT ts AS \"time\", (exchange || ' best_ask') AS metric,\n       (payload->'orderbook'->'asks'->0->>'price')::double precision AS value\nFROM mm_events\nWHERE event_type = 'MarketEvent' AND exchange IN (${exchange:sqlstring}) AND symbol IN (${symbol:sqlstring}) AND $__timeFilter(ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Best bid / ask",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
