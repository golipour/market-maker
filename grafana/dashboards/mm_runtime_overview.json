{
  "title": "MM Runtime Overview",
  "uid": "mm-runtime-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Controller Latency",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "mm_controller_latency_ms", "legendFormat": "{{exchange}} {{symbol}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Strategy Frames",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(mm_strategy_frames_total[1m])", "legendFormat": "{{exchange}} {{symbol}} {{hedge_status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Orders And Live State",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "mm_controller_order_count", "legendFormat": "controller orders"},
        {"expr": "mm_live_order_count", "legendFormat": "live {{exchange}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Persistence Writes And Errors",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "rate(mm_persistence_events_written_total[1m])", "legendFormat": "writes {{writer}}"},
        {"expr": "rate(mm_persistence_errors_total[1m])", "legendFormat": "errors {{writer}} {{error}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Inventory And Cash",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "mm_inventory", "legendFormat": "inventory {{exchange}}"},
        {"expr": "mm_cash", "legendFormat": "cash {{exchange}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Safety State",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {"expr": "mm_kill_switch_state", "legendFormat": "kill switch"},
        {"expr": "mm_observe_only_state", "legendFormat": "observe only"},
        {"expr": "rate(mm_risk_reject_total[1m])", "legendFormat": "risk rejects {{reason}}"}
      ]
    }
  ]
}
