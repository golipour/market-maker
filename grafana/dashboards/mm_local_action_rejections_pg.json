        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\",\n  kv.key AS metric,\n  (kv.value)::double precision AS value\nFROM mm_events e\nCROSS JOIN LATERAL jsonb_each(\n  COALESCE(e.payload #> ARRAY['action_pipeline','venue_quantized','rejection_counts'], '{}'::jsonb)\n) AS kv\nWHERE \n  e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange = '${exchange}'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Venue quantization rejections",
      "type": "timeseries"
    },
