          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\", reason AS metric, 1::double precision AS value\nFROM mm_events e\nCROSS JOIN LATERAL jsonb_array_elements_text(\n  COALESCE(e.payload->'execution_gates'->'blocked_reasons', '[]'::jsonb)\n) AS reason\nWHERE \n  e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange = '${exchange}'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Top-level blocked reasons (count per frame)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
