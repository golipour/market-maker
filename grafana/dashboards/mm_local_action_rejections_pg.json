          "countRows": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gate.key AS exchange,\n  COALESCE(gate.value->>'role', '') AS role,\n  COALESCE(gate.value->>'live', '') AS live,\n  COALESCE(gate.value->'blocked_reasons', '[]'::jsonb)::text AS blocked_reasons\nFROM mm_events e\nCROSS JOIN LATERAL jsonb_each(\n  COALESCE(e.payload->'execution_gates'->'venue_gates', '{}'::jsonb)\n) AS gate(key, value)\nWHERE \n  e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange = '${exchange}'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY e.ts DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Venue gate blocked reasons (latest frame)",
      "type": "table"
    }
