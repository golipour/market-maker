          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, $__interval),\n  AVG((payload->>'free')::double precision + (payload->>'locked')::double precision) AS value,\n  (exchange || ' ' || (payload->>'asset')) AS metric\nFROM mm_events\nWHERE topic LIKE 'private:state:%:balances'\n  AND exchange IN (${exchange:sqlstring})\n  AND payload->>'asset' IN (${asset:sqlstring})\n  AND $__timeFilter(ts)\nGROUP BY 1, exchange, (payload->>'asset')\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Balance (Free + Locked) For Asset",
      "type": "timeseries"
