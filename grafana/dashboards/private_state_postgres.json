          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, $__interval),\n  AVG(jsonb_object_length(payload->'open_orders'))::double precision AS value,\n  exchange AS metric\nFROM mm_events\nWHERE topic LIKE 'private:state:%:snapshot'\n  AND exchange IN (${exchange:sqlstring})\n  AND $__timeFilter(ts)\nGROUP BY 1, exchange\nORDER BY 1",
