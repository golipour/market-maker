          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', e.ts) AS \"time\", e.payload->>'status' AS metric,\n  COUNT(*)::double precision AS value\nFROM mm_events e\nWHERE \n  e.topic = '${hedge_diagnostics_topic}'\n  AND e.event_type = 'HedgeExecutionDiagnostic'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Hedge outcomes by status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\", 'unhedged_qty' AS metric,\n  (e.payload #>> '{residual,unhedged_qty}')::double precision AS value\nFROM mm_events e\nWHERE \n  e.topic = '${hedge_diagnostics_topic}'\n  AND e.event_type = 'HedgeExecutionDiagnostic'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\n  AND e.payload #>> '{residual,unhedged_qty}' IS NOT NULL\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Residual unhedged qty",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(e.payload->>'reason', 'unknown') AS reason,\n  COUNT(*) AS count\nFROM mm_events e\nWHERE \n  e.topic = '${hedge_diagnostics_topic}'\n  AND e.event_type = 'HedgeExecutionDiagnostic'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\n  AND e.payload->>'status' IN ('rejected', 'failed', 'skipped')\nGROUP BY 1\nORDER BY count DESC",
          "refId": "A"
        }
      ],
      "title": "Rejection reasons (count)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.ts,\n  e.payload->>'source_fill_id' AS source_fill_id,\n  e.payload->>'status' AS status,\n  e.payload->>'reason' AS reason,\n  e.payload #>> '{intent,primary_side}' AS primary_side,\n  e.payload #>> '{intent,hedge_side}' AS hedge_side,\n  (e.payload #>> '{intent,qty}')::double precision AS qty,\n  e.payload #>> '{hedge_order,client_order_id}' AS hedge_client_order_id\nFROM mm_events e\nWHERE \n  e.topic = '${hedge_diagnostics_topic}'\n  AND e.event_type = 'HedgeExecutionDiagnostic'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY e.ts DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Latest hedge trace",
      "type": "table"
    }
  ],
