      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\", gate.key AS metric,\n  CASE WHEN (gate.value->>'live')::boolean THEN 1 ELSE 0 END::double precision AS value\nFROM mm_events e\nCROSS JOIN LATERAL jsonb_each(COALESCE(e.payload->'execution'->'venue_gates', '{}'::jsonb)) AS gate(key, value)\nWHERE \n  e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange = '${exchange}'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Venue gate live flags",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres-mm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 2
      },
      "id": 11,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres-mm"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\", 'local_orders' AS metric,\n  jsonb_array_length(COALESCE(e.payload->'local'->'orders', '[]'::jsonb))::double precision AS value\nFROM mm_events e\nWHERE e.event_type = 'JointTargetBook'\n  AND e.symbol = '${symbol}'\n  AND $__timeFilter(e.ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Joint target book local order count",
      "type": "timeseries"
    },
