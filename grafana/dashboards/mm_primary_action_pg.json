          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT e.ts AS \"time\",\n  (e.payload #> ARRAY['action_pipeline','ladder','order_count'])::int::double precision AS value\nFROM mm_events e\nWHERE \n  e.topic = '${diagnostics_topic}'\n  AND e.event_type = 'ControllerDiagnostics'\n  AND e.exchange = '${exchange}'\n  AND e.symbol = '${symbol}'\n  AND e.actor_id = '${actor_id}'\n  AND $__timeFilter(e.ts)\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Order count \u2014 ladder",
      "type": "timeseries"
